# Key de Anthropic para que monitor.py genere el reporte de drift en
# lenguaje natural. Sin esto, monitor.py igual muestra los resultados
# numéricos del test de drift.
# Conseguí la tuya en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado para redactar el reporte (opcional, tiene un default)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Caso de uso que sirve serve.py por default cuando uvicorn importa el
# módulo directamente (sin poder pasarle --usecase). Opciones: churn, fraude
# USECASE=churn

# Proveedor para generar_informe.py: "ollama" (default, local, gratis) o
# "anthropic" (requiere ANTHROPIC_API_KEY con crédito)
# LLM_PROVIDER=ollama
